#!/usr/bin/env bash
# Wurrow 代码生成 + 构建脚本
# 用法: ./bin/generate [winui] [--no-build]
#
# 运行 perry-php 代码生成器，输出 MainWindow.xaml 和 MainWindow.xaml.cs
# 到 generated/ 目录，然后执行 dotnet publish 生成可执行文件。

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

echo "Wurrow Code Generator"
echo "====================="
echo "Project: $PROJECT_ROOT"
echo ""

cd "$PROJECT_ROOT"

# 检查 PHP 可用
if ! command -v php &> /dev/null; then
    echo "Error: PHP not found in PATH" >&2
    exit 1
fi

echo "PHP version: $(php -v | head -1)"
echo ""

# 确保 vendor 存在
if [ ! -d "vendor" ]; then
    echo "Running composer install..."
    composer install --no-interaction
fi

# 运行代码生成 + 构建
php src/Generate.php "$@"

echo ""
echo "Generated files:"
ls -la generated/ 2>/dev/null || echo "  (no files generated)"
