#!/usr/bin/env bash
# Wurrow PHP 后端服务器启动脚本
# 用法: ./bin/start-server [port]
#
# 启动 PHP 内置服务器，提供系统清理/优化/分析/软件管理的 HTTP API。
# 默认端口: 7891

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
PORT="${1:-7891}"

echo "Wurrow Backend Server"
echo "====================="
echo "Project: $PROJECT_ROOT"
echo "Port:    $PORT"
echo ""

cd "$PROJECT_ROOT"

# 检查 PHP 可用
if ! command -v php &> /dev/null; then
    echo "Error: PHP not found in PATH" >&2
    exit 1
fi

echo "PHP version: $(php -v | head -1)"

# 检查端口是否被占用
if lsof -i ":$PORT" -sTCP:LISTEN &> /dev/null 2>&1; then
    echo "Warning: Port $PORT is already in use."
    echo "Kill existing process? [y/N] "
    read -r answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
        lsof -ti ":$PORT" | xargs kill -9 2>/dev/null || true
        sleep 1
    else
        echo "Aborted."
        exit 1
    fi
fi

# 确保 vendor 存在
if [ ! -d "vendor" ]; then
    echo "Running composer install..."
    composer install --no-interaction
fi

echo ""
echo "Starting PHP server at http://localhost:$PORT"
echo "Press Ctrl+C to stop."
echo ""

# 启动服务器
exec php -S "localhost:$PORT" src/Backend/Server.php
